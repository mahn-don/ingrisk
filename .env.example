# Copy to .env and fill in. Never commit .env.

# Path to the SQLite database file (e.g. data/app.db).
DATABASE_PATH=
# Argon2id hash of the single user's login password.
APP_PASSWORD_HASH=
# Random secret (32+ bytes) used to sign session cookies.
SESSION_SECRET=
# Shared secret that scheduled jobs must send to protected cron endpoints.
CRON_SECRET=
# OpenAI API key for content generation.
OPENAI_API_KEY=
# Anthropic API key for content generation.
ANTHROPIC_API_KEY=
