# Copy to .env and fill in. Never commit .env.
#
# Production (the VPS, plans/phase-07.md): the file is <repo>/.env, owned by the deploy user,
# mode 600 (`chmod 600 .env`; deploy/install.sh refuses anything else). systemd reads it
# (EnvironmentFile=), deploy/deploy.sh reads ORIGIN from it for the build, deploy/prefetch.sh
# reads CRON_SECRET. Locally, the same file works with `npm run dev` and the CLIs.

# --- Server -------------------------------------------------------------------------------------

# The exact origin the browser uses: scheme, host and port, no trailing slash. It must match the
# address bar exactly, otherwise SvelteKit's CSRF check rejects the login form (403 "Cross-site
# POST form submissions are forbidden"). Read at BUILD time (vite.config.ts, paths.origin): with
# adapter-node 6 there is no runtime ORIGIN, and without it the server assumes https://. So build
# with it set (deploy/deploy.sh passes ORIGIN, and only ORIGIN, from this file to the build) and
# rebuild after changing it. At runtime it only decides whether the login page shows the
# unencrypted-connection notice.
# Current mode (the owner's decision): browser only, always online, plain HTTP on the server's IP.
ORIGIN=http://103.82.195.48:3000
# Send the session cookie only over HTTPS. Must be false while the app is served over plain HTTP
# (as above), or the browser drops the cookie and login never sticks. With false and a non-local
# ORIGIN the server logs a warning at startup and the login page shows "Kết nối không mã hóa".
# Set it to true once HTTPS is in front of the app (no code change needed).
COOKIE_SECURE=false
# Where adapter-node listens: every interface, port 3000 (reachable at the ORIGIN above). The
# deploy scripts check http://127.0.0.1:$PORT/healthz.
HOST=0.0.0.0
PORT=3000

# --- Storage ------------------------------------------------------------------------------------

# The SQLite database. In production an ABSOLUTE path inside the checkout's data/ directory, the
# only directory the systemd unit may write (ReadWritePaths), e.g. /home/deploy/ingrisk/data/app.db.
# Locally a relative path works (default data/app.db).
DATABASE_PATH=

# --- Secrets ------------------------------------------------------------------------------------

# Argon2id hash of the single user's login password: create it with `npm run auth:hash` and keep
# the single quotes it prints. Unset or invalid = nobody can log in and every page stays closed.
APP_PASSWORD_HASH=
# Shared secret the nightly cron sends to POST /api/cron/prefetch. Generate it with
#   openssl rand -hex 32
CRON_SECRET=
# LLM API keys: only the variable NAME is stored in the database (Cài đặt → Nhà cung cấp AI shows
# whether it is set, never its value). Anthropic is the provider in use; add others as needed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Cost cap -----------------------------------------------------------------------------------

# Refuse to start a generation run (prefetch, cloze:build, "Tạo thêm bài tập") when the last 24 h
# already hold this many LLM calls (default 500). Also set a spending limit at the provider.
LLM_DAILY_CALL_CAP=500

# --- Tests only ---------------------------------------------------------------------------------

# 1 answers every LLM call with canned responses (no network). The server refuses to start with
# it when NODE_ENV=production (the systemd unit sets NODE_ENV=production). Leave it unset.
LLM_CANNED=
