# Copy to .env and fill in. Never commit .env.

# Path to the SQLite database file (e.g. data/app.db).
DATABASE_PATH=
# Argon2id hash of the single user's login password: create it with `npm run auth:hash` and keep
# the single quotes it prints. Unset or invalid = nobody can log in and every page stays closed.
APP_PASSWORD_HASH=
# The exact origin the browser uses: scheme, host and port, no trailing slash. It must match the
# address bar exactly, otherwise SvelteKit's CSRF check rejects the login form (403 "Cross-site
# POST form submissions are forbidden"). Read at BUILD time (vite.config.ts, paths.origin): with
# adapter-node 6 there is no runtime ORIGIN, and without it the server assumes https://. So build
# with it set (ORIGIN=... npm run build) and rebuild after changing it. At runtime it only decides
# whether the login page shows the unencrypted-connection notice.
# Current mode (the owner's decision): browser only, always online, plain HTTP on the server's IP.
ORIGIN=http://103.82.195.48:3000
# Send the session cookie only over HTTPS. Must be false while the app is served over plain HTTP
# (as above), or the browser drops the cookie and login never sticks. With false and a non-local
# ORIGIN the server logs a warning at startup and the login page shows "Kết nối không mã hóa".
# Set it to true once HTTPS is in front of the app (no code change needed).
COOKIE_SECURE=false
# Where adapter-node listens: every interface, port 3000 (reachable at the ORIGIN above).
HOST=0.0.0.0
PORT=3000
# Shared secret that scheduled jobs must send to protected cron endpoints.
CRON_SECRET=
# OpenAI API key for content generation.
OPENAI_API_KEY=
# Anthropic API key for content generation.
ANTHROPIC_API_KEY=
# Refuse to start cloze:build when the last 24 h already hold this many LLM calls (default 500).
LLM_DAILY_CALL_CAP=500
