{
	"name": "silent-english",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:strings": "node scripts/check-strings.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"content:tatoeba-pairs": "node tool/build-tatoeba-pairs.ts",
		"content:prepare": "node tool/prepare-content.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env src/lib/server/db/migrate-cli.ts",
		"db:studio": "drizzle-kit studio",
		"srs:walkthrough": "node tool/srs-walkthrough.ts",
		"llm:provider:add": "node --env-file-if-exists=.env tool/llm-provider-add.ts",
		"llm:smoke": "node --env-file-if-exists=.env tool/llm-smoke.ts",
		"verify": "npm run check && npm run lint:strings && npm run test && npm run build"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.1",
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.3",
		"ts-fsrs": "5.4.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3",
		"word-list": "^4.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
